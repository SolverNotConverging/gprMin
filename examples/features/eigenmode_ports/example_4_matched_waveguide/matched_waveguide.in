#title: Example 4 - PML-free matched shielded microstrip

#domain: 0.300 0.012 0.006
#dx_dy_dz: 0.0005 0.0005 0.0005
#time_window: 18e-9

## This uniform, shielded microstrip is lossless and nondispersive. It
## deliberately has no PML: the two longitudinal faces are terminated by
## matched eigenmode boundaries for the retained quasi-TEM mode.
#pml_cells: 0

#material: 4.4 0 1 0 substrate

## PEC ground plane, dielectric substrate, and 2 mm-wide PEC strip.
#box: 0 0 0 0.300 0.012 0.0005 pec
#box: 0 0 0.0005 0.300 0.012 0.0020 substrate
#box: 0 0.005 0.0020 0.300 0.007 0.0025 pec

## Each reference plane is six ordinary, uniform guide cells from its outward
## domain face. The matched ADE acts at that face; depth_cells is not a PML or
## a convolution region. Only the listed mode is absorbed.
#eigenmode_band: microstrip_band 4.3e9 4.7e9 21
#eigenmode_port: 1 0.003 0 0.0005 0.003 0.012 0.006 + 1 auto
#eigenmode_port: 2 0.297 0 0.0005 0.297 0.012 0.006 - 1 auto
#eigenmode_match: 1 6
#eigenmode_match: 2 6
#eigenmode_excitation: 1 1 auto
#rx: 0.150 0.006 0.003

## Thin one-cell snapshots through the strip centre become an x-z field cut.
## The common scale in plot_results.py follows the pulse from launch, along the
## long uniform guide, into the passive matched face, and through ring-down.
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 2.70e-9 matched_microstrip_2700ps.h5
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 3.30e-9 matched_microstrip_3300ps.h5
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 3.90e-9 matched_microstrip_3900ps.h5
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 4.50e-9 matched_microstrip_4500ps.h5
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 5.40e-9 matched_microstrip_5400ps.h5
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 6.60e-9 matched_microstrip_6600ps.h5
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 8.50e-9 matched_microstrip_8500ps.h5
#snapshot: 0 0.006 0 0.300 0.0065 0.006 0.0005 0.0005 0.0005 15.0e-9 matched_microstrip_15000ps.h5
